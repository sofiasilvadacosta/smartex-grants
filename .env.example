# Postgres connection string (Neon / Vercel Postgres in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@localhost:5432/smartex_grants?schema=public"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# Google OAuth credentials, restricted to @smartex.ai in src/lib/auth.ts
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# HiBob (sistema de RH). Criar um service user em Settings → Integrations →
# Service users, com leitura em Employees, Employment, Salaries e Time off.
# No Vercel, marcar as duas como Sensitive.
HIBOB_SERVICE_USER_ID=""
HIBOB_API_TOKEN=""
