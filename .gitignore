# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# vendor agent-skill docs auto-installed by `prisma init` (reference only, not app code)
/.claude/
/.agents/
skills-lock.json

# source spreadsheets for the one-time historical import — contain salaries,
# supplier tax IDs and invoice data; never commit, place your own copies here
/imports/

# Python bytecode from the PDF extractors
__pycache__/
