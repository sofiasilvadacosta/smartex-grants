// Smartex Grants — Prisma schema. Fase 1: projetos, rubricas, faturas. Fase 2: pessoas, RH, pedidos de pagamento.
// See /root/.claude/plans/refactored-giggling-kettle.md for the full architecture and later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (Auth.js / NextAuth PrismaAdapter models) ----------

enum Role {
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EDITOR)
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  createdProjects         Project[]             @relation("ProjectCreatedBy")
  updatedProjects         Project[]             @relation("ProjectUpdatedBy")
  createdBudgetLines      BudgetLine[]          @relation("BudgetLineCreatedBy")
  updatedBudgetLines      BudgetLine[]          @relation("BudgetLineUpdatedBy")
  budgetChangeLogEntries  BudgetChangeLog[]     @relation("BudgetChangeLogChangedBy")
  createdInvoices         Invoice[]             @relation("InvoiceCreatedBy")
  updatedInvoices         Invoice[]             @relation("InvoiceUpdatedBy")
  reconciledInvoices      Invoice[]             @relation("InvoiceReconciledBy")
  reconciledAllocations   PersonnelAllocation[] @relation("PersonnelAllocationReconciledBy")
  createdPaymentRequests  PaymentRequest[]      @relation("PaymentRequestCreatedBy")
  createdPaymentDecisions PaymentDecision[]     @relation("PaymentDecisionCreatedBy")
  uploadedAttachments     Attachment[]          @relation("AttachmentUploadedBy")
  createdReceipts         Receipt[]             @relation("ReceiptCreatedBy")
  createdProjections      ReceiptProjection[]   @relation("ReceiptProjectionCreatedBy")
  createdDeliverables     Deliverable[]         @relation("DeliverableCreatedBy")
  createdSalaryRecords    SalaryRecord[]        @relation("SalaryRecordCreatedBy")
  createdAbsences         Absence[]             @relation("AbsenceCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Projects & budget ----------

enum ProjectStatus {
  ACTIVE
  CLOSED
  // Approved and running, but deliberately not managed in this platform (RHAQ).
  // Distinct from CLOSED, which means finished: an excluded project has no data
  // here because nobody put it here, not because there is nothing left to do.
  // Kept as a project rather than deleted so the decision stays visible and
  // reversible in one click.
  EXCLUDED
}

model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  fundingProgram String?
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus @default(ACTIVE)
  // Texia and TexQualis are budgeted and executed at a fixed eligible cost per
  // FTE (5189 € and 4432 € respectively) instead of from real salaries, so
  // execution for these projects is entered as FTE and multiplied by this rate.
  // Null for projects that report real invoiced/salary costs.
  fteRate        Decimal?      @db.Decimal(12, 2)

  budgetLines      BudgetLine[]
  invoices         Invoice[]
  allocations      PersonnelAllocation[]
  hoursAllocations ProjectHoursAllocation[]
  paymentRequests  PaymentRequest[]
  receipts         Receipt[]
  projections      ReceiptProjection[]
  deliverables     Deliverable[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// A "rubrica orçamental": one approved budget category within a project.
model BudgetLine {
  id              String   @id @default(cuid())
  projectId       String
  // For invoice-based projects this is the cost category ("RH 3-4",
  // "Equipamentos"). For FTE-based projects (Texia, TexQualis) the budget is
  // approved per profile within an activity, so category holds the profile.
  category        String
  // "" (not null) when the rubrica has no TRL phase / no activity — nullable
  // columns can't be used reliably inside the @@unique below (NULL isn't
  // comparable in SQL, and Prisma's compound-unique input type rejects null
  // there for exactly that reason).
  trlPhase        String   @default("")
  activity        String   @default("")
  // The funder's own line number in the approved "Quadro de Investimentos"
  // ("Nº ordem"), "" when the project's budget isn't numbered that way. Where
  // invoices carry it too, it links them to their rubrica exactly, with no
  // text matching involved. Part of the unique key because a funder can
  // approve several numbered lines with the same activity, classification and
  // year — without it those rows overwrite each other and budget is lost.
  orderNumber     String   @default("")
  // The funder's own job-title for this profile ("Perfil no Balcão"), needed
  // when reporting back to them. Null for invoice-based projects.
  externalProfile String?
  // Approved FTE for this line; the € below is plannedFte × Project.fteRate.
  plannedFte      Decimal? @db.Decimal(8, 2)
  eligibleCost    Decimal  @db.Decimal(14, 2)
  financingAmount Decimal  @db.Decimal(14, 2)
  // Denormalized cache of SUM(Invoice.eligibleAmount) + SUM(PersonnelAllocation.eligibleValue)
  // for this line, recomputed transactionally whenever a linked row's
  // budgetLineId or amount changes (see recomputeBudgetLineExecuted).
  executedAmount  Decimal  @default(0) @db.Decimal(14, 2)
  // What the funder's own payment-request document says was executed on this
  // line, when we have that document. Kept beside executedAmount rather than
  // replacing it so the two can be compared: a divergence means the platform
  // is missing rows (or holds rows the funder rejected), which is exactly what
  // needs to be seen before submitting the next request. Null = no official
  // figure imported for this line.
  declaredExecuted Decimal? @db.Decimal(14, 2)

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  allocations PersonnelAllocation[]
  changeLogs  BudgetChangeLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("BudgetLineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("BudgetLineUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([projectId, activity, category, trlPhase, orderNumber])
  @@index([projectId, orderNumber])
}

enum ChangeType {
  CREATE
  UPDATE
  DELETE
}

// Explicit audit trail for amendments to the approved investment plan — a
// first-class business requirement, distinct from the generic updatedAt trail.
model BudgetChangeLog {
  id           String     @id @default(cuid())
  budgetLineId String
  changeType   ChangeType
  changedField String?
  oldValue     String?
  newValue     String?
  reason       String?
  changedAt    DateTime   @default(now())
  changedById  String?

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  changedBy  User?      @relation("BudgetChangeLogChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([budgetLineId])
}

// ---------- Execution: invoices ----------

enum MatchStatus {
  UNMATCHED
  AMBIGUOUS
  MATCHED
  MANUAL_NO_MATCH
}

enum MatchMethod {
  SUGGESTED
  MANUAL
}

model Invoice {
  id               String  @id @default(cuid())
  projectId        String
  budgetLineId     String?
  paymentRequestId String?

  // Raw invoice fields (from *_Investments / PP sheets)
  category         String
  supplierName     String?
  supplierTaxId    String?
  country          String?
  docNumber        String?
  docDate          DateTime?
  totalValue       Decimal?  @db.Decimal(14, 2)
  vatValue         Decimal?  @db.Decimal(14, 2)
  nonDeductibleVat Decimal?  @db.Decimal(14, 2)
  eligibleAmount   Decimal   @db.Decimal(14, 2)

  // "Despesa apresentada" value group (newer PP sheets)
  presentedTotal    Decimal? @db.Decimal(14, 2)
  presentedVat      Decimal? @db.Decimal(14, 2)
  presentedEligible Decimal? @db.Decimal(14, 2)

  // "Despesa paga" value group
  paidTotal    Decimal? @db.Decimal(14, 2)
  paidEligible Decimal? @db.Decimal(14, 2)

  // "Documento de suporte do pagamento" value group
  paymentMethod    String?
  paymentReference String?
  paymentDate      DateTime?
  paymentDocValue  Decimal?  @db.Decimal(14, 2)

  ppNumber             String?
  eligibilityCertified Boolean?
  obs                  String?

  // Reconciliation of the source "Nº ordem (mapa investim)" -> BudgetLine link
  rawSourceRef    String?
  matchStatus     MatchStatus  @default(UNMATCHED)
  matchConfidence Decimal?     @db.Decimal(5, 2)
  matchMethod     MatchMethod?
  matchCandidates Json?
  reconciledById  String?
  reconciledAt    DateTime?

  // Import provenance / idempotency
  sourceSheet String
  sourceRowId String

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine     BudgetLine?     @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?
  createdBy    User?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?    @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reconciledBy User?    @relation("InvoiceReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceRowId])
  @@index([projectId, matchStatus])
  @@index([budgetLineId])
  @@index([paymentRequestId])
}

// ---------- People & capacity ----------

model Person {
  id        String    @id @default(cuid())
  name      String
  initials  String    @unique
  profile   String?
  entryDate DateTime?
  exitDate  DateTime?
  obs       String?
  active    Boolean   @default(true)

  capacities       PersonMonthCapacity[]
  hoursAllocations ProjectHoursAllocation[]
  allocations      PersonnelAllocation[]
  salaries         SalaryRecord[]
  absences         Absence[]
  deliverables     Deliverable[]            @relation("DeliverableResponsible")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Effective-dated pay. There is no current-salary column on Person on purpose:
// the eligible personnel cost of a month's work is computed from the pay in
// force *that* month, so a raise must add a row, never rewrite the past. A
// single column would silently restate every historical payment request the
// next time someone got a raise.
model SalaryRecord {
  id       String @id @default(cuid())
  personId String
  // First month this record applies to, "YYYY-MM". Month granularity because
  // personnel cost is declared to the funder by month, never by day.
  effectiveFrom String

  // Annual gross as tracked by HR (the "Salário" column of the DADOS sheet).
  // Informational only — eligible cost is never computed from it.
  grossAnnual Decimal? @db.Decimal(12, 2)
  // "RBM Elegível": the monthly base the funder accepts, and the only figure
  // eligible cost is computed from (see src/lib/personnel-cost.ts).
  //
  // Deliberately not derived from grossAnnual. In the source data the ratio
  // grossAnnual / monthlyBase is a constant 16,843 across every member of staff,
  // so the two clearly are proportional — but that factor matches no combination
  // of the funder's 14-months-over-11 rule and the 23,75% social security rate
  // (14 x 1,2375 = 17,325; 14 + 12 x 0,2375 = 16,85). Until the relationship is
  // confirmed, deriving one from the other would put an unexplained constant
  // underneath every cost this platform reports.
  monthlyBase Decimal? @db.Decimal(12, 2)
  // Employer social security rate for this person, when it differs from the
  // 23,75% every row in the source sheets uses.
  socialSecurityRate Decimal? @db.Decimal(6, 4)

  // Why it changed ("revisão anual", "promoção"), and for rows created by the
  // initial migration, what was reconstructed and what was assumed.
  reason String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("SalaryRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // One record per person per month: a correction replaces the row for that
  // month rather than adding a second, ambiguous one.
  @@unique([personId, effectiveFrom])
  @@index([personId, effectiveFrom])
}

enum AbsenceType {
  VACATION
  SICK
  PARENTAL
  UNPAID
  OTHER
}

// Time a person was not available, recorded by month rather than by date range.
// Everything else in this platform — capacity, allocation, declared cost — is
// monthly, and splitting a date range across months needs a holiday calendar we
// do not have. The dates are kept for reference when known.
model Absence {
  id        String      @id @default(cuid())
  personId  String
  yearMonth String
  type      AbsenceType
  // Working days absent within this month. Converted to hours with
  // HOURS_PER_WORKING_DAY (src/lib/capacity.ts) when computing free capacity.
  days      Decimal     @db.Decimal(5, 2)
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("AbsenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // No unique key on (person, month): a month can hold holiday and sick leave
  // as separate, separately-justified entries.
  @@index([personId, yearMonth])
}

// Company-wide working-hours calendar (HorasProdutivas sheet): how many hours
// a full-time month contains, independent of any person.
model WorkCalendar {
  yearMonth      String @id // "YYYY-MM"
  availableHours Int
}

// Per-person productive hours in a month (Recursos sheet, "Horas Produtivas"
// row of each person's block) — capacity after holidays/absences.
model PersonMonthCapacity {
  id              String  @id @default(cuid())
  personId        String
  yearMonth       String
  productiveHours Decimal @db.Decimal(8, 2)
  // Hours reserved for work outside the funded projects (product, operations,
  // customer support). Without it, someone fully booked on grants looks free
  // for more, which is the over-allocation this platform exists to prevent.
  nonProjectHours Decimal? @db.Decimal(8, 2)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, yearMonth])
}

// Hours a person is allocated to a project in a month (Recursos sheet, the
// per-project rows of each person's block). This is the *hours* view used for
// people-allocation planning — distinct from PersonnelAllocation, which is the
// eligible-*cost* imputation reported to the funding body.
model ProjectHoursAllocation {
  id        String @id @default(cuid())
  personId  String
  projectId String
  yearMonth String
  // The project activity these hours went to, as the funder's timesheet requires
  // ("É obrigatória a repartição das horas..."). "" for hours known only at
  // project level — every row the planning sheet produced, which has no activity
  // column. Part of the unique key, so a month can hold one row per activity.
  //
  // Stored as the label the timesheet uses ("2- Análise tecnológica...") and
  // matched to a budget line by its leading number: TexQualis's approved lines
  // carry the bare number, Texia's the full name, and rewriting either to agree
  // would change the key that identifies those lines.
  activity String  @default("")
  hours    Decimal @db.Decimal(8, 2)

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([personId, projectId, yearMonth, activity])
  @@index([projectId, yearMonth])
}

// ---------- Execution: personnel cost imputation (*_RH sheets) ----------

model PersonnelAllocation {
  id               String  @id @default(cuid())
  projectId        String
  budgetLineId     String?
  personId         String?
  paymentRequestId String?

  // Source person label verbatim (e.g. "1 - Diogo Afonso Correia Remião");
  // personId is resolved by name match and may stay null when unresolved.
  rawPersonLabel     String
  category           String
  yearMonth          String
  eligibleBaseSalary Decimal  @db.Decimal(12, 2)
  allocationPercent  Decimal  @db.Decimal(6, 4)
  socialSecurityRate Decimal  @db.Decimal(6, 4)
  // Set instead of the salary fields on FTE-based projects, where
  // eligibleValue = fte × Project.fteRate rather than a real salary
  // computation. Null on invoice/salary-based projects.
  fte                Decimal? @db.Decimal(8, 2)
  eligibleValue      Decimal  @db.Decimal(14, 2)
  ppNumber           String?
  certifiedEligible  Boolean?
  obs                String?

  // Same reconciliation model as Invoice: the "Nº ordem (mapa investim)"
  // string is the intended BudgetLine link but is inconsistent in the source.
  rawSourceRef    String?
  matchStatus     MatchStatus  @default(UNMATCHED)
  matchConfidence Decimal?     @db.Decimal(5, 2)
  matchMethod     MatchMethod?
  matchCandidates Json?
  reconciledById  String?
  reconciledAt    DateTime?

  sourceSheet String
  sourceRowId String

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine     BudgetLine?     @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  person         Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  reconciledBy   User?           @relation("PersonnelAllocationReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sourceRowId])
  @@index([projectId, matchStatus])
  @@index([budgetLineId])
  @@index([paymentRequestId])
}

// ---------- Payment requests & decisions ----------

enum DecisionStatus {
  PENDING
  APROVADO
  PARCIAL
  REJEITADO
}

model PaymentRequest {
  id              String    @id @default(cuid())
  projectId       String
  ppNumber        String
  submissionDate  DateTime?
  requestedAmount Decimal?  @db.Decimal(14, 2)
  // What the funder actually paid for this request, as stated by the funder
  // (a column in the payment-request workbook, a sentence in a decision). Kept
  // as a field rather than left inside the notes because it is what a bank
  // transfer is matched against, and because "approved minus paid" is the
  // outstanding amount the receipts screen reports.
  paidAmount      Decimal?  @db.Decimal(14, 2)
  notes           String?

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  allocations PersonnelAllocation[]
  decisions   PaymentDecision[]
  attachments Attachment[]
  receipts    Receipt[]
  projections ReceiptProjection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("PaymentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, ppNumber])
}

// 1:N off PaymentRequest (not 1:1) because grant decisions get revised or
// appealed in practice; isCurrent marks the decision in force.
model PaymentDecision {
  id               String         @id @default(cuid())
  paymentRequestId String
  decisionDate     DateTime?
  status           DecisionStatus @default(PENDING)
  approvedAmount   Decimal?       @db.Decimal(14, 2)
  notes            String?
  isCurrent        Boolean        @default(true)

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("PaymentDecisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([paymentRequestId])
}

enum AttachmentKind {
  REQUEST_DOC
  DECISION_DOC
}

// Uploaded supporting documents (the Word/PDF decision letters). Stored as
// bytea in Postgres rather than an external blob store: these are a handful of
// small documents per project, so keeping them in the database avoids a second
// service to provision and keeps backups atomic. Uploads are size-capped in
// the upload action.
model Attachment {
  id               String         @id @default(cuid())
  paymentRequestId String
  kind             AttachmentKind
  filename         String
  mimeType         String
  sizeBytes        Int
  content          Bytes

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  uploadedAt   DateTime @default(now())
  uploadedById String?
  uploadedBy   User?    @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([paymentRequestId])
}


// ---------- Money in: receipts and their forecasts ----------

model Receipt {
  id        String @id @default(cuid())
  projectId String
  // The request this money answers, when it can be established. The bank
  // statement names only the project, so most receipts arrive unlinked and are
  // matched afterwards — hence nullable rather than required.
  paymentRequestId String?

  receivedDate DateTime
  amount       Decimal  @db.Decimal(14, 2)
  // Free text as it appears on the statement. Kept verbatim: it is the only
  // evidence of which project a receipt belongs to.
  description     String?
  bankDescription String?
  currency        String  @default("EUR")
  notes           String?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  // Set when a forecast is fulfilled by this receipt; see ReceiptProjection.
  fulfils ReceiptProjection?

  sourceSheet String?
  sourceRowId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Only rows that came from a spreadsheet carry a sourceRowId; rows entered by
  // hand leave it null, which Postgres does not treat as a uniqueness conflict.
  @@unique([projectId, sourceRowId])
  @@index([projectId, receivedDate])
  @@index([paymentRequestId])
}

enum ProjectionStatus {
  FORECAST
  REALIZED
  CANCELLED
}

model ReceiptProjection {
  id               String  @id @default(cuid())
  projectId        String
  paymentRequestId String?

  projectedDate   DateTime
  projectedAmount Decimal          @db.Decimal(14, 2)
  status          ProjectionStatus @default(FORECAST)
  notes           String?

  // The forecast is never deleted when the money arrives: keeping both sides
  // is the only way to compare what was expected against what came in.
  realizedReceiptId String? @unique

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  realizedReceipt Receipt?       @relation(fields: [realizedReceiptId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("ReceiptProjectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, projectedDate])
}

// ---------- Deliverables and milestones ----------

enum DeliverableType {
  DELIVERABLE
  MILESTONE
}

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model Deliverable {
  id        String @id @default(cuid())
  projectId String

  name           String
  type           DeliverableType   @default(DELIVERABLE)
  status         DeliverableStatus @default(PLANNED)
  // The activity it belongs to, matching BudgetLine.activity, so a project's
  // deliverables can be read alongside the budget for the same activity.
  activity       String            @default("")
  dueDate        DateTime?
  completionDate DateTime?
  notes          String?

  responsiblePersonId String?

  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsiblePerson Person? @relation("DeliverableResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("DeliverableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, dueDate])
}

// ---------- Import tracking ----------

model ImportRun {
  id             String    @id @default(cuid())
  sourceFileName String
  sourceFileHash String
  sheetName      String
  rowsProcessed  Int       @default(0)
  rowsMatched    Int       @default(0)
  rowsUnmatched  Int       @default(0)
  rowsAmbiguous  Int       @default(0)
  errors         Json?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([sourceFileName, sheetName])
}
